# Neon Postgres (use the pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Unpooled connection string for Prisma CLI migrations (host without -pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Empty database used by `prisma migrate dev` to diff migrations
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST/shadow?sslmode=require"

# Clerk — https://dashboard.clerk.com → API Keys
# Enable Email code sign-in in Clerk Dashboard → User & Authentication
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Public site origin (used for Wompi redirect + webhook URLs)
SITE_URL="https://ailabs.sv"

# Wompi El Salvador — https://panel.wompi.sv (App ID + API Secret)
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
# Optional comma-separated commerce notification emails for payment links
WOMPI_NOTIFICATION_EMAIL=
